# ── OpenAI (valgfritt — aktiver med AI_PROVIDER=openai) ───────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Kunnskapsbase ─────────────────────────────────────────────
KNOWLEDGE_DIR=/var/www/shahnameh/hakim-bot/realshahnameh
