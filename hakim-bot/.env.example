# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_TOKEN=din_bot_token_fra_BotFather

# ── AI-leverandør: "anthropic" (anbefalt) eller "openai" ──────
AI_PROVIDER=anthropic

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
