  "standalone_nodes": {
    "ahriman": {
      "id": "ahriman",
      "name": "Ahriman",
      "type": "villain",
      "slug": null,
      "title": "Lord of Darkness",
      "era": "Primordial",
      "img": "/assets/images/enemies/ahriman-boss.png",
      "note": "Sent his son to kill Siamak",
      "lore": {
        "title": "The Eternal Adversary",
        "description": "Ahriman is the spirit of evil and darkness in the Zoroastrian cosmos. He sent his demonic son against Siamak, the son of Keyumars, causing the world's first grief. His influence darkens every age of the Shahnameh — from Zahhak's serpents to the fall of great kings.",
        "badge": "Antagonist"
      }
    },
    "afrasiab": {
      "id": "afrasiab",
      "name": "Afrasiab",
      "type": "villain",
      "slug": null,
      "title": "King of Turan",
      "era": "~1800–1600 BC",
      "img": "heroes/blak_demon.png",
      "note": "Eternal enemy of Iran — slayer of Siyavash",
      "lore": {
        "title": "The Great Adversary",
        "description": "Afrasiab, king of Turan, was the most feared enemy of Iran across three generations of Kayanian kings. His murder of Siyavash — the purest prince in the Shahnameh — set in motion a chain of vengeance that consumed both nations. He was finally slain by Kay Khosrow, the son of the man he murdered.",
        "badge": "Antagonist"
      }
    },
    "sudabeh": {
      "id": "sudabeh",
      "name": "Sudabeh",
      "type": "villain",
      "slug": null,
      "title": "Queen of Desire",
      "era": "~1700 BC",
      "img": "heroes/crystal_throne.png",
      "note": "Falsely accused Siyavash — drove him to his death",
      "lore": {
        "title": "The Fatal Queen",
        "description": "Sudabeh was the beautiful but dangerous wife of Kay Kavus. When Siyavash, the pure prince, refused her advances, she accused him of assault. Her false accusation drove the purest soul in the Shahnameh out of Iran — and into the arms of his death in Turan.",
        "badge": "Antagonist"
      }
    },
    "kaveh": {
      "id": "kaveh",
      "name": "Kaveh",
      "type": "hero",
      "slug": null,
      "title": "The Blacksmith of Iran",
      "era": "~5000 BC",
      "img": "heroes/iron_ax_of_hushang.png",
      "note": "Raised the Derafsh Kaviani — banner of revolt",
      "lore": {
        "title": "The Blacksmith Who Saved Iran",
        "description": "Kaveh was a simple blacksmith whose sons were fed to Zahhak's serpents. When he could bear it no more, he tore off his leather apron and raised it as a banner of revolt. That apron — the Derafsh Kaviani — became the sacred royal standard of Persia, and Kaveh became the eternal symbol of the people's uprising against tyranny.",
        "badge": "Story Character"
      }
    },
    "tahmineh": {
      "id": "tahmineh",
      "name": "Tahmineh",
      "type": "spouse",
      "slug": null,
      "title": "Princess of Samangan",
      "era": "~1800 BC",
      "img": "chapters/sohrab.png",
      "note": "Mother of Sohrab by Rostam",
      "lore": {
        "title": "The Princess of Samangan",
        "description": "Tahmineh, princess of Samangan, came to Rostam in the night, drawn by his legend. From their single union, Sohrab was born. She raised him alone, hiding his father's identity until it was too late — when Sohrab finally rode to find Rostam, neither father nor son recognised the other until the fatal blow had already fallen.",
        "badge": "Story Character"
      }
    },
    "sindokht": {
      "id": "sindokht",
      "name": "Sindokht",
      "type": "spouse",
      "slug": null,
      "title": "Queen of Kabul",
      "era": "~2500 BC",
      "img": "chapters/rudabeh.png",
      "note": "Mother of Rudabeh — wife of Mehrab",
      "lore": {
        "title": "Queen of Kabul",
        "description": "Sindokht was the wise queen of Kabul, wife of Mehrab and mother of Rudabeh. When Rudabeh's love for Zal threatened to destroy her family's alliance with the legacy of Zahhak, Sindokht navigated the dangerous political waters with courage and grace, ultimately helping broker peace between the families.",
        "badge": "Story Character"
      }
    },
    "jarireh": {
      "id": "jarireh",
      "name": "Jarireh",
      "type": "spouse",
      "slug": null,
      "title": "First Wife of Siyavash",
      "era": "~1700 BC",
      "img": "heroes/farvahar.png",
      "lore": {
        "title": "The Loyal Wife",
        "description": "Jarireh was the first wife of Siyavash, daughter of Piran the vizier. When Siyavash was killed at Afrasiab's command, Jarireh mourned him faithfully and raised their legacy in exile, embodying the loyal grief that the Shahnameh so often gives to women left behind by the wars of men.",
        "badge": "Story Character"
      }
    },
    "farangis": {
      "id": "farangis",
      "name": "Farangis",
      "type": "spouse",
      "slug": null,
      "title": "Princess of Turan",
      "era": "~1700 BC",
      "img": "chapters/kay-khosrow.png",
      "note": "Daughter of Afrasiab — mother of Kay Khosrow",
      "lore": {
        "title": "The Princess Between Two Worlds",
        "description": "Farangis was the daughter of Afrasiab, given in marriage to Siyavash as part of a peace accord. She loved her Iranian husband truly, and when he was murdered by her own father's command, she fled with her unborn child to safety. Her son would become Kay Khosrow — the king who would avenge his father and define an age.",
        "badge": "Story Character"
      }
    },
    "katayun": {
      "id": "katayun",
      "name": "Katayun",
      "type": "spouse",
      "slug": null,
      "title": "Queen of Persia",
      "era": "~1200 BC",
      "img": "heroes/farvahar.png",
      "lore": {
        "title": "The Foreign Queen",
        "description": "Katayun was a Roman princess who chose Goshtasp over wealth and power, recognising in him a future great king. She stood beside him through the religious revolution of Zarathustra, converting to the new faith and helping establish Zoroastrianism as the state religion of Iran.",
        "badge": "Story Character"
      }
    },
    "nahid": {
      "id": "nahid",
      "name": "Nahid",
      "type": "spouse",
      "slug": null,
      "title": "Princess of Macedonia",
      "era": "~380 BC",
      "img": "heroes/farvahar.png",
      "note": "Mother of Eskandar by Darab",
      "lore": {
        "title": "The Macedonian Princess",
        "description": "Nahid was a Macedonian princess given in marriage to Darab of Persia. The union was brief and unhappy — Darab sent her home when he found her breath unpleasant. She returned to Macedonia carrying his child. That child would grow up as Alexander, believing himself wholly Greek — until the Shahnameh reveals his Persian blood.",
        "badge": "Story Character"
      }
    },
    "roshanak": {
      "id": "roshanak",
      "name": "Roshanak",
      "type": "spouse",
      "slug": null,
      "title": "Persian Queen",
      "era": "~326 BC",
      "img": "heroes/farvahar.png",
      "note": "Daughter of Dara — married Eskandar after conquest",
      "lore": {
        "title": "The Persian Bride",
        "description": "Roshanak (Roxana in Greek histories) was the daughter of Dara, the last Persian king. After Eskandar's conquest, he married Roshanak — symbolically uniting the conqueror with the conquered royal line. In the Shahnameh's telling, this marriage was both a political act and a recognition of Persian legitimacy.",
        "badge": "Story Character"
      }
    }
  }
